        0,
        300
      ],
      "webhookId": "webapp-automatizacion-ia"
    },
    {
      "parameters": {
        "jsCode": "const TEMAS = ['Inteligencia artificial','Redes','Programación','Bases de datos','Internet de las cosas (IoT)'];\nconst NIVELES = ['Básico','Intermedio','Avanzado'];\nconst INTEG = ['nativo','http'];\nconst CLAVES = ['tema','nivel','pregunta','integracion'];\nlet b = $input.first().json.body;\nconst fail = (m) => [{ json: { ok: false, status: 400, mensaje: m } }];\nif (!b || typeof b !== 'object' || Array.isArray(b)) return fail('Revisa los campos e inténtalo de nuevo.');\nif (Object.keys(b).some(k => !CLAVES.includes(k))) return fail('Revisa los campos e inténtalo de nuevo.');\nfor (const k of CLAVES) if (typeof b[k] !== 'string') return fail('Revisa los campos e inténtalo de nuevo.');\nconst pregunta = b.pregunta.normalize('NFC').replace(/\\s+/g,' ').trim();\nif (!pregunta || pregunta.length > 1000) return fail('La pregunta es obligatoria y no puede superar 1000 caracteres.');\nif (!TEMAS.includes(b.tema) || !NIVELES.includes(b.nivel) || !INTEG.includes(b.integracion)) return fail('Revisa los campos e inténtalo de nuevo.');\nreturn [{ json: { ok: true, tema: b.tema, nivel: b.nivel, pregunta, integracion: b.integracion } }];"
      },
      "name": "Validar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "¿Entrada válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "tema",
              "value": "={{ $json.tema }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "nivel",
              "value": "={{ $json.nivel }}",
              "type": "string"
            },
            {
              "id": "a3",
