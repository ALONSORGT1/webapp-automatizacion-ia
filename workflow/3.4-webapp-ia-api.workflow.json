            },
            {
              "id": "a4",
              "name": "integracion",
              "value": "={{ $json.integracion }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Normalizar entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
