{
  "name": "3.4 Web app para automatización IA - API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webapp-automatizacion-ia",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
