    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "s1",
                    "leftValue": "={{ $json.integracion }}",
                    "rightValue": "nativo",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "nativo"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "s2",
                    "leftValue": "={{ $json.integracion }}",
                    "rightValue": "http",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "http"
            }
          ]
        },
        "options": {}
      },
      "name": "Elegir integración",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "response",
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "id"
        },
        "responses": {
          "values": [
            {
              "role": "user",
              "content": "Tema: {{ $json.tema }}\nNivel: {{ $json.nivel }}\nPregunta: {{ $json.pregunta }}"
            }
          ]
        },
        "options": {
          "instructions": "Eres un asistente académico de Tecnologías de la Información. Responde en español de México. Ajusta la profundidad al nivel indicado. Estructura la respuesta con: Concepto, Funcionamiento, Ejemplo y Recomendación técnica. Sé conciso, claro y verificable; si no estás seguro de algo, dilo.",
          "maxTokens": 700
        }
      },
      "name": "OpenAI (nativo)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1120,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "openAiApi": {
          "id": "VINCULAR",
          "name": "VINCULAR credencial OpenAI"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4.1-mini', instructions: \"Eres un asistente académico de Tecnologías de la Información. Responde en español de México. Ajusta la profundidad al nivel indicado. Estructura la respuesta con: Concepto, Funcionamiento, Ejemplo y Recomendación técnica. Sé conciso, claro y verificable; si no estás seguro de algo, dilo.\", input: 'Tema: ' + $json.tema + '\\nNivel: ' + $json.nivel + '\\nPregunta: ' + $json.pregunta, max_output_tokens: 700 }) }}",
        "options": {
          "timeout": 50000
        }
      },
      "name": "OpenAI (HTTP Request)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "openAiApi": {
          "id": "VINCULAR",
          "name": "VINCULAR credencial OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const base = $('Normalizar entrada').first().json;\nconst r = $input.first().json || {};\nfunction textos(o, out = []) {\n  if (o == null) return out;\n  if (typeof o === 'string') return out;\n  if (Array.isArray(o)) { o.forEach(x => textos(x, out)); return out; }\n  if (typeof o === 'object') {\n    if ((o.type === 'output_text' || o.type === 'text') && typeof o.text === 'string') out.push(o.text);\n    for (const v of Object.values(o)) if (typeof v === 'object') textos(v, out);\n  }\n  return out;\n}\nlet t = '';\nif (typeof r.output_text === 'string') t = r.output_text;\nelse if (typeof r.text === 'string') t = r.text;\nelse t = textos(r).join('\\n');\nt = (t || '').trim();\nif (r.error || !t) return [{ json: { ok: false, status: 502, mensaje: 'El asistente no pudo generar una respuesta. Inténtalo de nuevo.' } }];\nreturn [{ json: { ok: true, status: 200, respuesta: t, tema: base.tema, nivel: base.nivel, integracion: base.integracion } }];"
      },
      "name": "Normalizar salida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => { const {status, ...rest} = $json; return JSON.stringify(rest); })() }}",
        "options": {
          "responseCode": "={{ $json.status || 200 }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1600,
        300
      ]
    }
